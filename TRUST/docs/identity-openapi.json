    "/api/v1/identities/{id}/retry": {
      "post": {
        "operationId": "retryIdentity",
        "summary": "retry身份",
        "description": "普通恢复需要retry；保存的action=REVOKE或desiredState=DELETED还需要revoke。403不改变任务、证书、请求回执及审计。",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
