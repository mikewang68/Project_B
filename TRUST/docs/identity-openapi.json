{
  "openapi": "3.0.3",
  "info": {
    "title": "TRUST + IAM Identity API",
    "version": "identity-v1",
    "description": "独立联调协议。TRUST使用独立服务Bearer；IAM使用持久会话JWT。生命周期实际状态必须查询响应体。"
  },
  "servers": [
    {
      "url": "https://approved-isolated-instance.invalid",
      "description": "使用私有配置中的IAM或TRUST地址，不能指向旧演示服务"
    }
  ],
  "security": [
    {
      "identityService": []
    }
  ],
  "paths": {
    "/api/v1/identities": {
      "post": {
        "operationId": "provisionIdentity",
        "summary": "提交稳定业务主体的期望状态",
        "description": "IAM在本地事务提交后调用；revision由唯一调用方递增。返回证书不含私钥、key_ref或注册秘密。相同revision必须相同内容。READY需真实Gateway核验；合约权限不自动授予。所有触发证书吊销的命令均要求revoke权限，包括SYNC且desiredState=DELETED；disable仅允许平台停用。",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9:_-]{16,128}$"
            },
            "description": "同一操作重试保持原值；同键异文409。"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IdentityCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "当前身份READY",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Identity"
                }
              }
            }
          },
          "202": {
            "description": "已持久化但非READY；可查询状态",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Identity"
                }
              }
            }
          },
          "400": {
            "description": "无效参数或未知字段",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "独立服务凭据无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "发行方/租户/组织/操作越权",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "身份不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "同键异文、过期revision或生命周期冲突",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "配置或组件不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
