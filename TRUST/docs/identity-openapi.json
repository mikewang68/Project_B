  "components": {
    "securitySchemes": {
      "identityService": {
        "type": "http",
        "scheme": "bearer",
        "description": "每issuer/tenant唯一调用方，token摘要存私有配置，限制orgs和operations；不接受浏览器/WMS凭据"
      },
      "iamSession": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "真实IAM会话，在线校验当前用户和角色权限"
      }
    },
    "schemas": {
      "IdentityCommand": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issuer",
          "tenant",
          "userId",
          "orgId",
          "revision",
          "desiredState",
          "action"
        ],
        "properties": {
          "issuer": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,80}$"
          },
          "tenant": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,80}$"
          },
          "userId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,80}$"
          },
          "orgId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,80}$"
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "desiredState": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "DISABLED",
              "DELETED"
            ]
          },
          "action": {
            "type": "string",
            "enum": [
              "SYNC",
              "ROTATE",
              "REVOKE"
            ]
          }
        }
      },
      "Certificate": {
        "type": "object",
        "properties": {
          "org_id": {
            "type": "string",
            "nullable": true
          },
          "msp_id": {
            "type": "string",
            "nullable": true
          },
          "enrollment_id": {
            "type": "string",
            "nullable": true
          },
          "state": {
            "type": "string",
            "nullable": true
          },
          "fingerprint": {
            "type": "string",
            "nullable": true
          },
          "certificate_pem": {
            "type": "string",
            "nullable": true
          },
          "network_state": {
            "type": "string",
            "nullable": true
          },
          "crl_state": {
            "type": "string",
            "nullable": true
          },
          "version": {
            "type": "integer"
          },
          "not_before": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "not_after": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "Identity": {
        "type": "object",
        "required": [
          "identityId",
          "issuer",
          "tenant",
          "userId",
          "orgId",
          "revision",
          "status",
          "desiredState",
          "contractAuthorization",
          "certificates",
          "certificateVersion"
        ],
        "properties": {
          "identityId": {
            "type": "string"
          },
          "issuer": {
            "type": "string"
          },
          "tenant": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "orgId": {
            "type": "string"
          },
          "desiredState": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "ISSUED",
              "NETWORK_PENDING",
              "READY",
              "RETRY",
              "DISABLED",
              "DELETED",
              "REVOCATION_PENDING",
              "CRL_PENDING",
              "REVOKED",
              "EXPIRED"
            ]
          },
          "certificateVersion": {
            "type": "integer"
          },
          "contractAuthorization": {
            "type": "string",
            "enum": [
              "NOT_GRANTED"
            ]
          },
          "errorCode": {
            "type": "string",
            "nullable": true
          },
          "certificates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Certificate"
            }
          }
        }
      },
      "Task": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "nullable": true
          },
          "state": {
            "type": "string",
            "nullable": true
          },
          "desiredState": {
            "type": "string",
            "nullable": true
          },
          "identityId": {
            "type": "string",
            "nullable": true
          },
          "errorCode": {
            "type": "string",
            "nullable": true
          },
          "revision": {
            "type": "integer"
          },
          "identity": {
            "$ref": "#/components/schemas/Identity"
          }
        }
      },
      "UserCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "username",
          "name",
          "password",
          "roleIds",
          "orgCodes",
          "status"
        ],
        "properties": {
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 64
          },
          "name": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 6,
            "writeOnly": true
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "roleIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "orgCodes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "disabled"
            ]
          }
        }
      },
      "UserResult": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "fabricIdentity": {
            "$ref": "#/components/schemas/Task"
          }
        }
      },
      "IamUserResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "enum": [
              0
            ]
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/UserResult"
          }
        }
      },
      "IamTaskResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "enum": [
              0
            ]
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/Task"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
