  "components": {
    "schemas": {
      "EventInput": {
        "type": "object",
        "properties": {
          "sourceSystem": {
            "type": "string",
            "minLength": 1,
            "pattern": "[A-Za-z0-9._-]{1,80}"
          },
          "sourceEventId": {
            "type": "string",
            "minLength": 1,
            "pattern": "[A-Za-z0-9._-]{1,120}"
          },
          "eventType": {
            "type": "string",
            "minLength": 1,
            "pattern": "[A-Z_]{1,40}"
          },
          "businessObjectId": {
            "type": "string",
            "maxLength": 120,
            "minLength": 0
          },
          "batchId": {
            "type": "string",
            "maxLength": 120,
            "minLength": 0
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "bundleIds": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 120,
              "minLength": 0
            },
            "maxItems": 80,
            "minItems": 0
          },
          "handoverId": {
            "type": "string",
            "maxLength": 120,
            "minLength": 0
          },
          "relatedBatchIds": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 120,
              "minLength": 0
            },
            "maxItems": 80,
            "minItems": 0
          },
          "relatedEventRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "[A-Za-z0-9._-]{1,80}:[A-Za-z0-9._-]{1,120}"
            },
            "maxItems": 80,
            "minItems": 0
          },
          "quantity": {
            "type": "number",
            "minimum": 0
          },
          "unit": {
            "type": "string",
            "maxLength": 20,
            "minLength": 0
          },
          "location": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          },
          "supplier": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          },
          "receiver": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "[a-f0-9-]{36}"
            },
            "maxItems": 20,
            "minItems": 0
          },
          "details": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "batchId",
          "businessObjectId",
          "eventType",
          "occurredAt",
          "sourceEventId",
          "sourceSystem"
        ]
      },
      "CsrfToken": {
        "type": "object",
        "properties": {
          "parameterName": {
            "type": "string"
          },
          "token": {
            "type": "string"
          },
          "headerName": {
            "type": "string"
          }
        }
      },
      "IamLogin": {
        "type": "object",
        "required": [
          "username",
          "password",
          "orgId"
        ],
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "orgId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        }
      },
      "WalletChange": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "mspId": {
            "type": "string"
          },
          "keyRef": {
            "type": "string"
          },
          "walletId": {
            "type": "string"
          },
          "sourceSystem": {
            "type": "string"
          },
          "certificateFingerprint": {
            "type": "string"
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "WalletProposal": {
        "type": "object",
        "required": [
          "action",
          "change",
          "reason"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "REGISTER",
              "BIND",
              "DISABLE"
            ]
          },
          "change": {
            "$ref": "#/components/schemas/WalletChange"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "WalletReview": {
        "type": "object",
        "required": [
          "approve"
        ],
        "properties": {
          "approve": {
            "type": "boolean"
          }
        }
      },
      "WmsEventInput": {
        "allOf": [
          {
            "$ref": "#/components/schemas/EventInput"
          },
          {
            "type": "object",
            "required": [
              "quantity",
              "unit",
              "details"
            ],
            "properties": {
              "eventType": {
                "type": "string",
                "enum": [
                  "WAREHOUSE_IN",
                  "DISPATCH"
                ]
              },
              "quantity": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "details": {
                "type": "object",
                "required": [
                  "companyCode",
                  "warehouseCode",
                  "ownerCode",
                  "operatorId"
                ],
                "properties": {
                  "companyCode": {
                    "type": "string",
                    "minLength": 1
                  },
                  "warehouseCode": {
                    "type": "string",
                    "minLength": 1
                  },
                  "ownerCode": {
                    "type": "string",
                    "minLength": 1
                  },
                  "operatorId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "allocationId": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        ],
        "description": "DISPATCH 还必须含 details.allocationId 和非空 relatedEventRefs。引用仅允许同来源其他收货事件，父子须同批次、单位和公司/仓库/货主，收货业务时间不能晚于发运。允许来源收货迟到，缺失引用明确展示；WAREHOUSE_IN 不接受 relatedEventRefs。"
      },
      "SignerPolicy": {
        "type": "object",
        "required": [
          "orgId",
          "sourceSystem",
          "mspId",
          "fingerprint",
          "enabled",
          "revision",
          "changeId",
          "eventTypes"
        ],
        "properties": {
          "orgId": {
            "type": "string"
          },
          "sourceSystem": {
            "type": "string"
          },
          "mspId": {
            "type": "string"
          },
          "fingerprint": {
            "type": "string"
          },
          "changeId": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "eventTypes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 80,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z_]{1,40}$"
            },
            "description": "每个managed来源均按此明确白名单授权。当前TRUST导出WAREHOUSE_IN与DISPATCH；SetSigner去重排序。历史策略省略/null时只兼容这两类，不代表任意类型。显式空数组拒绝。"
          }
        }
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "JSESSIONID"
      },
      "sourceBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "来源服务专用凭据，非 IAM 用户令牌"
      }
    }
  },
  "security": [
    {
      "sessionCookie": []
    }
  ]
}
