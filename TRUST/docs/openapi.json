      "get": {
        "tags": [
          "托管钱包"
        ],
        "summary": "导出当前已批准绑定的链上授权策略",
        "description": "平台导出不代表链上授权已完成；仅专用隔离通道由网络管理员登记。 导出eventTypes白名单；2.1合约对所有来源逐项校验，旧策略省略时仅允许首批收货/发运。",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignerPolicy"
