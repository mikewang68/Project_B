TRUST_DB_USER=trust_iam_dev_app
TRUST_DB_PASSWORD=REPLACE_PRIVATELY
TRUST_FABRIC_CHANNEL=trust-iam-dev
TRUST_FABRIC_QUERY_KEY_REF=identity-dev-query-v1
