# ============================================================================
# Isolated gateway (BFF) configuration sample
# Copy to a 0600 file outside the repository (e.g. ~/.secrets/bff_secrets.env)
# and point E12_SECRETS_FILE at it, or export these variables directly.
# ============================================================================

# --- listener ---------------------------------------------------------------
BFF_PORT=18295
BFF_BIND=127.0.0.1

# --- upstream services ------------------------------------------------------
IAM_PORT=18086
SYS_PORT=18082
WMS_BASE_URL=http://127.0.0.1:18084
EHMS_BASE_URL=http://127.0.0.1:18083
SCS_API_BASE_URL=http://127.0.0.1:18080
SCS_FE_BASE_URL=http://127.0.0.1:18088
TRUST_BASE=http://127.0.0.1:28185
EMCS_BASE=http://127.0.0.1:18095

# --- shared secret ----------------------------------------------------------
# REQUIRED. Must be >= 32 characters. No default is shipped.
# The gateway signs its own short-lived WMS tickets with this key; the WMS
# backend must trust the same key.
SSO_JWT_SECRET=<generate with: openssl rand -hex 32>

# --- static content root ----------------------------------------------------
# Directory containing artifacts/frontend/{portal,iam,sys} and logs/
BASE_DIR=/srv/project-b/portal-runtime
# Optional overrides for the native SPA bundles served under /ehm/ and /safety/
# EHMS_WEB_DIR=/srv/project-b/portal-runtime/artifacts/frontend/ehm
# SCS_WEB_DIR=/srv/project-b/portal-runtime/artifacts/frontend/safety
# LOG_DIR=/srv/project-b/portal-runtime/logs

# --- CSRF allow-list --------------------------------------------------------
# Comma separated host:port values added to the default 127.0.0.1/localhost
# entries. Keep this minimal; do not use wildcards.
# CSRF_EXTRA_ORIGINS=portal.example.internal:18295

# --- unsafe test switches ---------------------------------------------------
# Never enable outside a throwaway environment.
LEGACY_BRIDGE_UNSAFE_FOR_RELEASE=false

# --- secrets file (read on startup if present) ------------------------------
E12_SECRETS_FILE=/home/example/.secrets/bff_secrets.env
