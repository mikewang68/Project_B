# Server profile: existing openGauss, not MongoDB/H2. Fill only in private runtime config.
AUDIT_PORT=18110
AUDIT_BIND=127.0.0.1
AUDIT_DB_URL=jdbc:postgresql://database.example.internal:5432/project?currentSchema=audit
AUDIT_DB_USER=
AUDIT_DB_PASSWORD=
AUDIT_CLIENTS_FILE=/srv/b-project/audit/runtime/secrets/clients.json
AUDIT_AUTO_DDL=false
# Keep disabled until content approval, source matrix, credentials and real E2E are signed off.
AUDIT_CHAIN_ENABLED=false
AUDIT_CHAIN_MODE=generic
AUDIT_TRUST_SOURCES_FILE=
AUDIT_TRUST_MAX_WAIT_SECONDS=86400
# The following single destination values apply ONLY to explicit legacy mode.
AUDIT_CHAIN_BASE_URL=
AUDIT_CHAIN_TOKEN_FILE=
