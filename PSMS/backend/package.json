{
  "name": "psms-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PSMS 生产调度管理模块后端服务（Express 5 + MongoDB）",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "tsx src/seeds/seed.ts",
    "seed:built": "node dist/seeds/seed.js",
    "db:stats": "tsx src/scripts/db-stats.ts",
    "smoke": "tsx src/scripts/smoke-test.ts"
  },
  "dependencies": {
    "bcryptjs": "3.0.2",
    "cors": "2.8.5",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "jsonwebtoken": "9.0.3",
    "mongodb-memory-server": "11.2.0",
    "mongoose": "8.19.1",
    "morgan": "1.10.0",
    "pino": "10.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/morgan": "1.9.10",
    "@types/node": "24.7.2",
    "pino-pretty": "13.1.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
