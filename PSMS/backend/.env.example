# ============================================================
# PSMS 后端服务配置模板
# 复制为 .env 后按需修改
# ============================================================

# ---------- MongoDB ----------
# 留空 = 自动启动内嵌的真实 mongod（数据持久化到 MONGODB_DATA_DIR）
# 填写 URI = 连接外部 MongoDB 实例，例如 mongodb://127.0.0.1:27017/psms
MONGODB_URI=
MONGODB_DB_NAME=psms

# 内嵌 mongod 监听端口（固定端口，便于用 mongosh / Compass 直连排查）
MONGODB_EMBEDDED_PORT=27017

# 内嵌 mongod 数据目录（相对 backend/ 解析），WiredTiger 引擎持久化
MONGODB_DATA_DIR=.data/mongodb

# mongod 二进制缓存目录（首次启动联网下载，之后离线可用）
MONGOMS_DOWNLOAD_DIR=.cache/mongodb-binaries
MONGOMS_VERSION=7.0.14

# 启动时若集合为空则自动灌入种子数据
AUTO_SEED=true

# ---------- JWT ----------
# 生产环境务必替换为强随机值（至少 16 位）
JWT_SECRET=change-me-in-production-please-use-a-long-random-secret
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# ---------- Server ----------
PORT=3100
NODE_ENV=development

# ---------- CORS ----------
# 允许的前端来源，多个来源用逗号分隔
CORS_ORIGIN=http://localhost:5173

# ---------- Logging ----------
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
