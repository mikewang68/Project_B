# ============================================================
# PSMS 后端服务配置模板
# 复制为 .env 后按需修改
#
# 存储选型遵循组内基线的「多存储各司其职」（见 EHMS/docs/EHM-architecture-baseline.md）：
#   openGauss  = 事务/业务数据（计划、工单、任务、设备、异常、联锁、预约、离线包、配置、审计）
#   openGemini = 时序/遥测数据（设备遥测）
# ============================================================

# ---------- openGauss（业务主库） ----------
# 集群内直接填 node4 的地址；开发机不在内网，需先建 SSH 隧道并指向 127.0.0.1
#   ssh -N -L 5432:192.168.101.57:5432 <user>@<跳板机>
OPENGAUSS_HOST=127.0.0.1
OPENGAUSS_PORT=5432
OPENGAUSS_DATABASE=psms
OPENGAUSS_USERNAME=psms
# ⚠️ 口令含 #、$ 等字符时必须用引号包起来，否则 dotenv 会把 # 之后当行内注释截断
OPENGAUSS_PASSWORD="change-me"
OPENGAUSS_SCHEMA=public
OPENGAUSS_POOL_MAX=10
OPENGAUSS_POOL_MIN=2
# 经隧道访问建连较慢（约 10 秒），直连集群时可调小到 8000
OPENGAUSS_CONNECT_TIMEOUT_MS=30000
OPENGAUSS_IDLE_TIMEOUT_MS=60000
OPENGAUSS_STATEMENT_TIMEOUT_MS=60000
# 启动时幂等补齐表结构
OPENGAUSS_AUTO_MIGRATE=true

# ---------- openGemini（时序库） ----------
# 集群内为 http://<node6>:8086；开发机经隧道时指向 127.0.0.1
#   ssh -N -L 8086:192.168.101.74:8086 <user>@<跳板机>
OPENGEMINI_ENABLED=true
OPENGEMINI_URL=http://127.0.0.1:8086
OPENGEMINI_DATABASE=psms_telemetry
OPENGEMINI_USERNAME=
OPENGEMINI_PASSWORD=
OPENGEMINI_TIMEOUT_MS=5000
OPENGEMINI_WRITE_ENABLED=true

# 启动时若业务表为空则自动灌入种子数据
AUTO_SEED=true

# ---------- JWT ----------
# 生产环境务必替换为强随机值（至少 16 位）
JWT_SECRET=change-me-in-production-please-use-a-long-random-secret
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# ---------- Server ----------
PORT=3100
NODE_ENV=development

# ---------- CORS ----------
# 允许的前端来源，多个来源用逗号分隔
CORS_ORIGIN=http://localhost:5173

# ---------- Logging ----------
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
