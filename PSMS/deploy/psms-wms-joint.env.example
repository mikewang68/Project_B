# Install actual values in /etc/project-b/PSMS/joint-test.env with mode 600.
# This example is for the independent joint-test instance on node6.
NODE_ENV=production
HOST=127.0.0.1
PORT=21910
AUTO_SEED=false
AUDIT_MAINTENANCE_ENABLED=false
OPENGAUSS_AUTO_MIGRATE=false
OPENGAUSS_HOST=192.168.101.57
OPENGAUSS_PORT=5432
OPENGAUSS_DATABASE=psms_wms_joint_test
OPENGAUSS_USERNAME=
OPENGAUSS_PASSWORD=
OPENGEMINI_ENABLED=false
OPENGEMINI_WRITE_ENABLED=false
JWT_SECRET=
PSMS_RAILWAY_ENABLED=false
PSMS_SSO_ENABLED=true
PSMS_IAM_BASE_URL=
PSMS_SSO_SERVICE_TOKEN=
PSMS_SSO_BINDINGS_FILE=/etc/project-b/PSMS/joint-test-bindings.json
PSMS_COOKIE_SECURE=true
PSMS_WMS_ENABLED=true
PSMS_WMS_DATABASE=psms_wms_joint_test
PSMS_WMS_BASE_URL=http://127.0.0.1:21984
# Independent credentials for the two directions. Each is at least 32 characters.
PSMS_WMS_SEND_TOKEN=
PSMS_WMS_RECEIVE_TOKEN=
# Fill actual company/owner codes supplied by WMS. Example codes are not defaults.
PSMS_WMS_COMPANY_CODE=
PSMS_WMS_OWNER_CODE=
