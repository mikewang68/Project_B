# ============================================================================
# Backend Demo 环境变量模板
# 复制到 /etc/b-project/backend.env（node4 / node5 各一份），只保留变量名与占位，
# 真实密码/地址不写入 Git。server profile 启动时读取本文件。
# ============================================================================

# ---- JVM ----
JAVA_OPTS="-Xms256m -Xmx768m -XX:+ExitOnOutOfMemoryError -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai"

# ---- 服务 ----
SERVER_ADDRESS=0.0.0.0
SERVER_PORT=18080
SPRING_PROFILES_ACTIVE=server

# ---- CORS（浏览器侧真实来源，逗号分隔；经 Nginx/Easegress 同源时可只填实际域名）----
CORS_ALLOWED_ORIGINS="http://__PUBLIC_HOST__,https://__PUBLIC_HOST__"

# ---- openGauss 6.0.5 ----
OPENGAUSS_HOST=__OPENGAUSS_HOST__
OPENGAUSS_PORT=5432
OPENGAUSS_DATABASE=b_project
OPENGAUSS_USERNAME=b_project
OPENGAUSS_PASSWORD=__REPLACE_ME__
OPENGAUSS_POOL_MAX=10

# ---- Kvrocks 2.16.0（Redis 协议）----
KVROCKS_HOST=__KVROCKS_HOST__
KVROCKS_PORT=6666
KVROCKS_PASSWORD=
KVROCKS_DATABASE=0

# ---- RocketMQ 5.5.0 NameServer（多个用分号分隔）----
ROCKETMQ_ENABLED=true
ROCKETMQ_NAMESRV_ADDR=__ROCKETMQ_NAMESRV__
ROCKETMQ_PRODUCER_GROUP=safety-control-demo-producer

# ---- openGemini 1.5.2 ----
OPENGEMINI_ENABLED=true
OPENGEMINI_URL=http://__OPENGEMINI_HOST__:8086

# ---- 幂等键 TTL（秒）----
IDEMPOTENCY_TTL_SECONDS=600

# ---- 演示用户（Demo 阶段固定身份，可切换）----
DEMO_USER_ID=USR-001
DEMO_USER_NAME=李娜
DEMO_USER_ROLE=安全员
DEMO_USER_TEAM=安全管理组
DEMO_USER_SHIFT=夜班

# ---- 日志 ----
APP_LOG_LEVEL=INFO
