# Template only. Inject private values through the deployment secret store.
SERVER_ADDRESS=127.0.0.1
SYS_SERVER_PORT=8082
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=REPLACE_WITH_APPROVED_SYS_DATABASE
