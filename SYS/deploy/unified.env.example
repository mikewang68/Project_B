SYS_SSO_ENABLED=true
SYS_SSO_IAM_BASE_URL=https://identity.example.invalid/api/v1/iam
SYS_SSO_SERVICE_TOKEN=REPLACE_WITH_SYS_ONLY_RANDOM_SERVICE_CREDENTIAL
SYS_SSO_BINDINGS_FILE=/srv/project-b/SYS/runtime/secrets/subject-bindings.json
CORS_ALLOWED_ORIGINS=https://settings.example.invalid
