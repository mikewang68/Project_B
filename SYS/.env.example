# 复制为 .env.local 后按需修改；.env.local 不会进入 git
# 后端 REST 入口，默认同源 /api/v1
# SYS 业务接口 context-path 为 /api/v1/sys；登录/登出走 IAM /api/v1/iam
VITE_API_BASE_URL=/api/v1
# 本地开发时代理目标（IAM 认证中心 8081 / SYS 业务 8082）
VITE_DEV_IAM_TARGET=http://127.0.0.1:8081
VITE_DEV_SYS_TARGET=http://127.0.0.1:8082
# 子路径部署时设置，如 /sys/
# VITE_BASE=/sys/
