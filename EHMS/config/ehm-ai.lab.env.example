# 实验室模型专用配置示例；不含真实Key。由configure-lab-model.sh生成私有配置。
EHM_AI_ENABLED=false
EHM_AI_PROVIDER='实验室千问'
# 示例主机名不是可用服务；按环境负责人提供的服务器可达地址替换。
EHM_AI_BASE_URL=http://model.example.internal:18047/v1
# 填/models实际返回的完整ID，不能直接猜qwen3、Qwen3-32B等名称。
EHM_AI_MODEL=
EHM_AI_API_KEY=
EHM_AI_API_KEY_FILE=/opt/b-project/ehm/config/.lab-model-api-key
EHM_AI_TRUSTED_HTTP_ORIGIN=http://model.example.internal:18047
EHM_AI_DATA_POLICY=anonymized
EHM_AI_TIMEOUT_SECONDS=45
# 初始接入以服务端预检索+模型分析运行，不假设千问网关已支持function calling。
EHM_AI_TOOLS_ENABLED=false
