# Backend-only. Load AFTER original database/IAM environment. Never reset the old EHM_AI_* settings.
# The existing single-model settings remain usable; these two profiles are independent overrides.
EHM_AI_DEFAULT_MODEL=lab-qwen
EHM_AI_LAB_ENABLED=true
EHM_AI_LAB_BASE_URL=http://model.example.internal:18047/v1
EHM_AI_LAB_MODEL=Qwen3.8-27B
EHM_AI_LAB_API_KEY_FILE=/data/projects/Project_B/private/ehms/lab-model.key
EHM_AI_LAB_DATA_POLICY=anonymized
EHM_AI_LAB_TRUSTED_HTTP_ORIGIN=http://model.example.internal:18047
EHM_AI_LAB_TOOLS_ENABLED=false
EHM_AI_LAB_TIMEOUT_SECONDS=45
# If your OLD EHM_AI_* settings already point to DeepSeek, omit the following overrides to retain them.
# Otherwise enable this independent profile AFTER supplying a real DeepSeek key file.
# EHM_AI_DEEPSEEK_ENABLED=true
# EHM_AI_DEEPSEEK_BASE_URL=https://api.deepseek.com
# EHM_AI_DEEPSEEK_MODEL=deepseek-chat
# EHM_AI_DEEPSEEK_API_KEY_FILE=/data/projects/Project_B/private/ehms/deepseek.key
# EHM_AI_DEEPSEEK_DATA_POLICY=anonymized
# EHM_AI_DEEPSEEK_TOOLS_ENABLED=true
