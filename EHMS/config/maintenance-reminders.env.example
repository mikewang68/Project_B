# Opt-in, demo-only, disabled when omitted. No account/password or IAM grants are changed.
# Only PROJECT_B / EHMS_DEMO / EHMS, and only dossiers marked SIMULATED are scanned.
# Scope authorization/provisioning must already be established; this is not an IAM bypass.
EHM_MAINTENANCE_DEMO_REMINDERS_ENABLED=false
EHM_MAINTENANCE_DEMO_REMINDERS_DELAY_MS=900000
EHM_MAINTENANCE_DEMO_REMINDERS_INITIAL_DELAY_MS=60000
