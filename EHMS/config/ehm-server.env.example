# EHM服务器档公开示例：请把示例主机名、地址和路径替换为现场值。
SPRING_PROFILES_ACTIVE=server
EHM_SERVER_PORT=18083
EHM_CONFIG_PATH=/opt/b-project/ehm/config/.config.server.json
EHM_ALLOWED_ORIGINS=http://192.0.2.74:18090
# Java 17已在服务器PATH中时无需填写；否则改成实际java可执行文件路径。
JAVA_BIN=java

# openGauss（应用/数据库节点）：账号密码由环境负责人分配，禁止提交真实密码。
EHM_OPENGAUSS_HOST=node4.example.internal
EHM_OPENGAUSS_PORT=5432
EHM_OPENGAUSS_DATABASE=ehm
EHM_OPENGAUSS_SCHEMA=ehm
EHM_OPENGAUSS_USERNAME=__FILL_ME__
EHM_OPENGAUSS_PASSWORD=__FILL_ME__
EHM_OPENGAUSS_AUTO_DDL=false
EHM_DB_POOL_MIN_IDLE=2
EHM_DB_POOL_MAX_SIZE=20

# openGemini（时序节点）：示例服务端口8086。
EHM_OPENGEMINI_BASE_URL=http://node6.example.internal:8086
EHM_OPENGEMINI_DATABASE=ehm_telemetry
EHM_OPENGEMINI_USERNAME=
EHM_OPENGEMINI_PASSWORD=
EHM_OPENGEMINI_WRITE_ENABLED=true

# 首次服务器联调保持关闭；拿到统一IAM与证书参数后再开启。
EHM_JWT_ENABLED=false
EHM_RBAC_ENABLED=false
EHM_TLS_ENABLED=false
EHM_AI_ENABLED=false
EHM_AI_BASE_URL=
EHM_AI_API_KEY=
EHM_AI_MODEL=

# Common audit: fill only in private environment. Empty endpoint retains the local durable queue.
EHM_AUDIT_DOMAIN=unassigned
EHM_AUDIT_ZONE=unassigned
EHM_AUDIT_ENDPOINT=
EHM_AUDIT_TOKEN_FILE=
EHM_AUDIT_INTERVAL_MS=5000
# Existing IAM /auth/me full URL. This is identity verification, not complete EHM RBAC.
EHM_AUDIT_IAM_ME_URL=
EHM_AUDIT_IAM_REQUIRED=false
# Apply sql/003_audit_tasks.sql first. Scoped export is opt-in, authenticated stable user IDs only.
EHM_AUDIT_TASK_MAX_SECONDS=900
EHM_AUDIT_EVIDENCE_EXPORT_ENABLED=false
EHM_AUDIT_EVIDENCE_EXPORT_ACTORS=
# Read-only journal access: default users see only their own events.
# Explicit stable IAM user IDs allowed to read this EHM module's journal (not other apps/zones).
EHM_AUDIT_QUERY_ACTORS=
# Dedicated AUDIT READ credential, never the write credential and never sent to the browser.
EHM_AUDIT_READER_TOKEN_FILE=
# Local login or centralized IAM. Never use disabled for a shared/production instance.
EHM_AUTH_MODE=local
EHM_AUTH_BOOTSTRAP_FILE=/private/ehm/auth-bootstrap.json
EHM_AUTH_TABLE_PREFIX=auth_
EHM_AUTH_COOKIE_NAME=EHM_SESSION
# true behind HTTPS; false only for an explicitly isolated HTTP/SSH preview.
EHM_AUTH_COOKIE_SECURE=true
EHM_AUTH_SESSION_HOURS=8
EHM_AUTH_IDLE_MINUTES=30
# Keep disabled for shared/production deployments. Opt-in isolated synthetic demonstrations only.
EHM_SAMPLE_DATA_ENABLED=false
EHM_TELEMETRY_ADAPTER=openGemini
