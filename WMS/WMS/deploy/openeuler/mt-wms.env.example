# MT-WMS application runtime settings.
# Install as /etc/mt-wms/mt-wms.env with mode 0600; never commit real passwords.

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=18080

# Use 127.0.0.1 when the JAR and openGauss are both on database-node.
# Use the node4 hostname/IP when the JAR runs on another node.
WMS_DB_URL=jdbc:postgresql://127.0.0.1:5432/mt_wms?currentSchema=public
WMS_DB_USERNAME=wms_app
WMS_DB_PASSWORD=replace-with-a-strong-password
WMS_DB_POOL_SIZE=10

# Import/export files must survive service restarts.
WMS_FILES_DIR=/var/lib/mt-wms/files

# Adjust to the memory limit assigned to the service.
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -Dfile.encoding=UTF-8
