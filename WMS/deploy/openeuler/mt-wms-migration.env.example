# Database-administrator settings used only by scripts/migrate-opengauss.sh.
# Install as /etc/mt-wms/mt-wms-migration.env with mode 0600.
# Do not load this file into the application service: it contains an admin password.

CONTAINER_RUNTIME=isula
OPENGAUSS_CONTAINER_NAME=replace-with-the-node4-opengauss-container-name
OPENGAUSS_GSQL_BIN=/usr/local/opengauss/bin/gsql
OPENGAUSS_LIBRARY_PATH=/usr/local/opengauss/lib:/scws/lib

WMS_DB_NAME=mt_wms
WMS_DB_ADMIN_USERNAME=omm
WMS_DB_ADMIN_PASSWORD=replace-with-the-database-admin-password
