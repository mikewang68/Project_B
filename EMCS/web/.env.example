VITE_APP_TITLE=能源管理与控制系统
VITE_APP_ENV=production
VITE_APP_BASE_PATH=/emcs/
VITE_APP_BASE_API=/emcs-api
# Local development: use / and /dev-api, with the proxy below.
VITE_API_TARGET=http://127.0.0.1:18103

# Exact origin of the approved Portal; no wildcard or URL path. Empty disables the SSO browser handoff.
VITE_EMCS_SSO_PORTAL_ORIGIN=
