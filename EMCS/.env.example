# 复制为 backend/.env.dev（骨架按 APP_ENV 加载 .env.{env}，默认 dev），本文件只做口径参考，.env.* 不入库
APP_ENV=dev
APP_PORT=9099
APP_ROOT_PATH=/dev-api

# JWT 密钥请用 openssl rand -hex 32 重新生成
JWT_SECRET_KEY=please-regenerate-me

DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=demo
DB_PASSWORD=bdemo_dev
DB_DATABASE=b_demo

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=2
