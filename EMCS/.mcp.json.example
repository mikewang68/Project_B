{
  "//": "按需改名为 .mcp.json 启用。示例：给团队挂 MySQL 检查与浏览器走查两个 MCP。也可以不用项目级 .mcp.json，改在某个 agent 的 frontmatter mcpServers 里内联定义（只对该 agent 生效）。",
  "mcpServers": {
    "mysql": {
      "command": "npx",
      "args": ["-y", "@benborla29/mcp-server-mysql"],
      "env": {
        "MYSQL_HOST": "127.0.0.1",
        "MYSQL_PORT": "3306",
        "MYSQL_USER": "demo",
        "MYSQL_PASS": "<改成本地口令>",
        "MYSQL_DB": "b_demo"
      }
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    }
  }
}
