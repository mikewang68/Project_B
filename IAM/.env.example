# 复制为 .env.local 后按需修改；.env.local 不会进入 git
# 后端 REST 入口，默认同源 /api/v1（IAM 后端 context-path 为 /api/v1/iam）
VITE_API_BASE_URL=/api/v1
# 本地开发时代理目标（IAM 后端端口 8081）
VITE_DEV_API_TARGET=http://127.0.0.1:8081
# 子路径部署时设置，如 /iam/
# VITE_BASE=/iam/
# 可选开发账号按钮，默认不显示；构建时注入，全部内容会公开到浏览器。
# password 字段仅用于明确允许公开的开发账号密码，不得填入未经授权公开的凭据或 token。
# VITE_LOGIN_ACCOUNTS='[{"label":"开发管理员","username":"your-dev-account","description":"用户与权限管理"}]'
